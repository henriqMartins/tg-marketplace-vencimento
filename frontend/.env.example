# Copie para .env.local (fica fora do git) e ajuste.

# Quem atende cada grupo do contrato (docs/api/contrato.md):
#   mock  → tudo no mock (padrão)
#   http  → tudo na API real
#   A,B   → só os grupos A e B na API real; o resto no mock
# Atenção: o login vem do grupo A. Com A no mock, o backend real responde 401 às rotas
# que exigem login. Para usar a API real com login (loja, gestor), use VITE_API=http.
# O backend só aceita o navegador vindo de http://localhost:5173 (CORS): use `npm run dev`.
VITE_API=mock

# Endereço da API real (Django local)
VITE_API_URL=http://localhost:8000

# Atraso artificial das respostas do mock, em ms (para ver os esqueletos)
VITE_MOCK_ATRASO_MS=400
