{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "**/mock/*",
              "**/mock"
            ],
            "message": "Telas não importam o mock: use o cliente de src/api (index.ts). Regra do BRIEFING-agente.md."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/api/index.ts",
        "src/api/mock/**",
        "src/test/**",
        "src/**/*.test.ts",
        "src/**/*.test.tsx"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    },
    {
      "files": [
        "src/test/**",
        "src/app/rotas.tsx"
      ],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
