# Copie para .env e preencha. Nunca commite o .env.

# Banco local do docker-compose (Docker do WSL 2). Escolha uma senha qualquer só sua.
POSTGRES_USER=tg
POSTGRES_PASSWORD=
POSTGRES_DB=tg

# PostgreSQL que o Django usa. Local: monte com os valores acima.
# Produção (Neon): endereço direto, sem pooler.
DATABASE_URL=postgres://tg:SENHA_ACIMA@localhost:5432/tg
# Neon: postgres://usuario:senha@host/banco?sslmode=require

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Token que protege o endpoint de varredura chamado pelo agendamento diário da Vercel
CRON_TOKEN=

# Endereços do frontend que podem chamar a API pelo navegador (CORS), separados por vírgula.
# Local (Vite): http://localhost:5173 · Produção: o endereço da Vercel.
CORS_ALLOWED_ORIGINS=http://localhost:5173
